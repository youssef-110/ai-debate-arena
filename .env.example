# --- Groq (free) --------------------------------------------
# Powers the llama-3.3-70b-versatile debater.
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Google Gemini (free) -----------------------------------
# Powers the gemini-2.5-flash debater.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Server --------------------------------------------------
# Port the Express server listens on (optional, default 3000)
PORT=3000
