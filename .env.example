# ============================================================
#  AI DEBATE ARENA — Environment Variables
#  Copy this file to `.env` and fill in your keys.
#  NEVER commit your real .env file.
# ============================================================

# --- Groq (free) --------------------------------------------
# Powers the openai/gpt-oss-120b debater.
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Google Gemini (free) -----------------------------------
# Powers the gemini-2.5-flash debater.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Server --------------------------------------------------
# Port the Express server listens on (optional, default 3000)
PORT=3000

# --- Optional ------------------------------------------------
# Groq model to use (default openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
# AI calls allowed per visitor every 10 minutes (a full debate is 11 calls)
RATE_LIMIT_PER_10_MIN=60
# AI calls allowed across all visitors every 10 minutes
GLOBAL_LIMIT_PER_10_MIN=600
